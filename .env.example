# ── DB (docker compose up -d) ───────────────────
DATABASE_URL="postgresql://grantdesk:grantdesk@localhost:5433/grantdesk?schema=public"

# ── Auth.js ──────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → OAuth 클라이언트(웹). 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 이 도메인 이메일만 로그인 허용 (예: bearing.institute)
ALLOWED_EMAIL_DOMAIN=
# 개발 전용 로그인(구글 키 없이 화면 확인용). production에서는 무시된다
AUTH_DEV_LOGIN=0

# ── 소싱 ─────────────────────────────────────────
# 기업마당: bizinfo.go.kr > 활용정보 > 정책정보 개방 > 지원사업정보 API 사용신청
# K-Startup: data.go.kr 15125364 활용신청 (일반 인증키)
BIZINFO_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# ── LLM (URL 추출 M1, 점수 M2, 초안 M4) ─────────────────────────────────────
ANTHROPIC_API_KEY=
# 비우면 claude-opus-5-5
LLM_MODEL_EXTRACT=
LLM_MODEL_SCORE=
LLM_MODEL_DRAFT=
# 한 번에 점수 매길 최대 공고 수 (비용 상한). 소싱 직후·평일 매시 30분에 이만큼씩
SCORE_MAX_PER_RUN=30

# ── 알림 (M3) ────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── 파일 저장 ────────────────────────────────────
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

APP_BASE_URL=http://localhost:3000
