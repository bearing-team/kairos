# ── DB (docker compose up -d) ───────────────────
DATABASE_URL="postgresql://grantdesk:grantdesk@localhost:5433/grantdesk?schema=public"

# ── Auth.js ──────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → OAuth 클라이언트(웹). 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 이 도메인 이메일만 로그인 허용 (예: bearing.institute)
ALLOWED_EMAIL_DOMAIN=
# 개발 전용 로그인(구글 키 없이 화면 확인용). production에서는 무시된다
AUTH_DEV_LOGIN=0

# ── 소싱 ─────────────────────────────────────────
# 기업마당: bizinfo.go.kr > 활용정보 > 정책정보 개방 > 지원사업정보 API 사용신청
# K-Startup: data.go.kr 15125364 활용신청 (일반 인증키)
BIZINFO_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# ── LLM (URL 추출 M1, 점수 M2, 초안 M4) ─────────────────────────────────────
# 아래 키들(ANTHROPIC_API_KEY, SLACK_WEBHOOK_URL, BIZINFO_API_KEY, DATA_GO_KR_SERVICE_KEY)은 비워 두고
# 앱의 회사 프로필 → 연결 키에서 넣어도 된다 (DB에 암호화). 여기 값이 있으면 이쪽이 먼저
ANTHROPIC_API_KEY=
# 비우면 claude-opus-5-5
LLM_MODEL_EXTRACT=
LLM_MODEL_SCORE=
LLM_MODEL_DRAFT=
# 한 번에 점수 매길 최대 공고 수 (비용 상한). 소싱 직후·평일 매시 30분에 이만큼씩
SCORE_MAX_PER_RUN=30
# 게시판 하나를 확인할 때 열어 볼 새 글 수 (글마다 LLM 1회). 나머지는 다음 확인 때
BOARD_MAX_PER_RUN=8

# ── 알림 (M3) ────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── 파일 저장 ────────────────────────────────────
# local(기본) | s3. 배포(Amplify·Fargate)는 디스크가 남지 않아서 s3
STORAGE_DRIVER=local
# 첨부 저장 폴더 (local일 때, 기본 ./storage — 커밋 안 함)
STORAGE_DIR=
# s3일 때. AWS에서는 역할(Amplify 컴퓨트 역할·ECS 작업 역할)로 접근해서 키를 비운다
# S3 호환 저장소(MinIO 등)면 S3_ENDPOINT + 키
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── 응답 뒤 작업 (초안·점수·게시판 확인·리뷰 요청 Slack) ─────────
# 비우면 웹 프로세스의 after()로 바로 (로컬 기본). queue면 pg-boss 큐에 넣고 `pnpm worker`가 처리 (Amplify 배포)
BACKGROUND_JOBS=

# Neon처럼 풀러 주소와 직접 주소가 따로면 직접 주소 (마이그레이션·워커용). 없으면 DATABASE_URL
DATABASE_URL_UNPOOLED=

# Slack 메시지 속 링크. 배포에서는 웹 주소(Amplify 도메인)를 넣는다
APP_BASE_URL=http://localhost:3000
