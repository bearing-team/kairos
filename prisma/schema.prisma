// 지원사업 데스크 — Prisma 스키마
// M0: 인증 + 회사 / M1: 아이템 카드, 제외 규칙, 공고, 첨부, 소싱 기록
// 매칭·진행·초안 모델은 M2부터 docs/ARCHITECTURE.md 3절 이름 그대로 추가한다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth.js (@auth/prisma-adapter) ─────────────────

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  sessions          Session[]
  applicationEvents ApplicationEvent[]
  drafts            Draft[]
  comments          ReviewComment[]    @relation("CommentAuthor")
  resolvedComments  ReviewComment[]    @relation("CommentResolver")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── 회사 (지금은 1개. 확장 여지로 다른 테이블은 companyId를 둔다) ──

enum BizType {
  corporation // 법인
  individual // 개인
}

model Company {
  id             String          @id @default(cuid())
  name           String
  industryLabel  String? // 사이드바 요약용 한 줄 (예: "SW 스타트업")
  foundedAt      DateTime? // → 업력 자동 계산 (KST)
  region         String? // 시/도 (예: "부산")
  ksicCodes      String[]
  bizType        BizType?
  certifications String[]
  headcount      Int?
  revenueBand    String?
  ceoBirthYear   Int?
  description    String? // 주력 사업 한 문단
  itemCards      ItemCard[]
  exclusionRules ExclusionRule[]
  matches        Match[]
  applications   Application[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// 주력 아이템 (예: ONDECKK). 초안 생성의 핵심 재료. 숫자는 사람이 넣은 것만
model ItemCard {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  problem         String?
  solution        String?
  customer        String?
  differentiation String?
  traction        String?
  links           String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
}

enum ExclusionKind {
  keyword // 제목·요약에 포함되면 제외
  region // 이 지역 한정 공고 제외
  target // 이 대상 전용 공고 제외 (예: 예비창업자)
  industry // 이 업종 전용 공고 제외 (예: 제조)
}

model ExclusionRule {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      ExclusionKind
  value     String
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([companyId])
}

// ── 공고 (소스 무관 정규화) ─────────────────────

enum AnnouncementSource {
  bizinfo
  kstartup
  manual
  newsletter
  board // 등록한 게시판에서 찾은 공고
}

model Announcement {
  id                String             @id @default(cuid())
  source            AnnouncementSource
  externalId        String // 소스의 공고 ID. 수동 추가는 정규화한 URL
  url               String?
  title             String
  organization      String? // 소관/주관 기관
  executingOrg      String? // 수행 기관
  summary           String? // 본문 요약(태그 제거한 텍스트)
  target            String? // 지원 대상
  regionLimit       String? // 지역 제한 (전국이면 null)
  applyStart        DateTime? // KST 자정을 UTC로 저장
  applyEnd          DateTime? // KST 마감일 자정(그날 23:59까지 접수로 본다)
  applyPeriodText   String? // 원문 신청기간 문자열 ("상시" 등 날짜로 못 바꾸는 경우 보존)
  supportAmountText String?
  category          String? // 지원 분야
  hashtags          String[]
  applyUrl          String? // 신청 페이지
  raw               Json // 원본 응답 항목
  contentHash       String // 정규화 필드 해시 → 변경 감지 (M2 재점수 대상)
  dedupeKey         String // normalize(title)|organization|applyEnd
  duplicateOfId     String? // 다른 소스의 같은 공고면 대표 공고 id
  duplicateOf       Announcement?      @relation("Duplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        Announcement[]     @relation("Duplicate")
  boardSourceId     String? // source=board일 때 찾은 게시판
  boardSource       BoardSource?       @relation(fields: [boardSourceId], references: [id], onDelete: SetNull)
  attachments       Attachment[]
  matches           Match[]
  applications      Application[]
  firstSeenAt       DateTime           @default(now())
  lastSeenAt        DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([source, externalId])
  @@index([dedupeKey])
  @@index([applyEnd])
  @@index([boardSourceId])
}

enum AttachmentKind {
  notice // 공고문
  form // 신청서·계획서 양식
  other
}

enum ParseStatus {
  pending
  parsed
  failed
}

// 첨부. 소싱 때는 메타데이터만, 초안을 만들 때(M4) 내려받아 storage/에 저장하고 글자를 뽑는다
model Attachment {
  id             String         @id @default(cuid())
  announcementId String
  announcement   Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  fileName       String
  url            String
  fileKey        String? // storage/ 안의 파일 이름 (sha256.확장자)
  mime           String?
  size           Int?
  sha256         String?
  downloadedAt   DateTime?
  kind           AttachmentKind @default(other)
  parsed         Json? // { format, chars }
  text           String? // 뽑은 글자 (표는 "칸 | 칸" 줄)
  parseStatus    ParseStatus    @default(pending)
  parseError     String?
  drafts         Draft[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([announcementId, url])
}

model SyncRun {
  id         String             @id @default(cuid())
  source     AnnouncementSource
  startedAt  DateTime           @default(now())
  finishedAt DateTime?
  fetched    Int                @default(0)
  created    Int                @default(0)
  updated    Int                @default(0)
  error      String?
  boardSourceId String? // source=board일 때 어느 게시판
  boardSource   BoardSource? @relation(fields: [boardSourceId], references: [id], onDelete: Cascade)

  @@index([source, startedAt])
  @@index([boardSourceId, startedAt])
}

// 직접 등록한 공고 게시판(목록 페이지). 매일 열어서 새 글 중 지원사업 공고를 찾아 가져온다
model BoardSource {
  id            String         @id @default(cuid())
  name          String
  url           String         @unique // 정규화한 목록 주소
  enabled       Boolean        @default(true)
  knownLinks    String[] // 이미 판단을 끝낸 글 주소 (공고 아님·저장함·이미 있음). 새 링크만 LLM에 보낸다
  checkingAt    DateTime? // 확인 중이면 시작 시각 (오래되면 멈춘 것으로 본다)
  lastCheckedAt DateTime?
  lastError     String?
  lastNote      String? // 마지막 확인 결과 한 줄 ("새 공고 2건")
  announcements Announcement[]
  runs          SyncRun[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ── M2: 매칭·진행 상태 ───────────────────────────────

enum ScoreStatus {
  pending // 점수 매길 차례 (LLM 키가 없으면 여기 머문다)
  running
  scored
  failed
  skipped // 하드필터 탈락 → 점수 안 매김
}

enum Eligibility {
  eligible
  uncertain
  ineligible
}

/// 공고 × 회사 매칭 결과 (ARCHITECTURE.md 5절)
model Match {
  id                  String       @id @default(cuid())
  announcementId      String
  announcement        Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  companyId           String
  company             Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hardFilterPassed    Boolean
  excludeReason       String? // 하드필터 탈락 사유 (사람이 읽는 문장)
  filterNotes         String[] // 통과했지만 확인이 필요한 점 (예: 설립일 미입력)
  scoreStatus         ScoreStatus  @default(pending)
  score               Int? // 0-100
  reasons             Json? // string[]
  risks               Json? // string[]
  eligibility         Eligibility?
  suggestedItemCardId String?
  scoredHash          String? // 점수 매길 때의 Announcement.contentHash → 바뀌면 다시 매김
  model               String?
  promptVersion       String?
  scoredAt            DateTime?
  scoreError          String?
  application         Application?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([announcementId, companyId])
  @@index([companyId, scoreStatus])
}

enum ApplicationStatus {
  new
  triage
  drafting
  review
  submitted
  result_pass
  result_fail
  excluded
}

/// 진행 단위 (상태 파이프라인). 전이는 서버에서만 검증 (src/lib/transitions.ts)
model Application {
  id              String             @id @default(cuid())
  announcementId  String
  announcement    Announcement       @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// 같은 (공고, 회사)의 매칭 결과. refreshMatches가 Match를 먼저 만든다
  match           Match              @relation(fields: [announcementId, companyId], references: [announcementId, companyId], onDelete: Cascade)
  status          ApplicationStatus  @default(new)
  autoExcluded    Boolean            @default(false) // 하드필터가 제외함 (사람 판단은 false) → 조건이 바뀌면 자동 복귀
  excludedReason  String?
  ownerId         String?
  reviewerIds     String[]
  submittedAt     DateTime?
  resultNote      String?
  statusChangedAt DateTime           @default(now())
  events          ApplicationEvent[]
  deadlineAlerts  DeadlineAlert[]
  drafts          Draft[]
  requiredDocs    RequiredDoc[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([announcementId, companyId])
  @@index([companyId, status])
}

/// 상태 변경 기록 = 사람의 판단 기록 (PRD F3.4). userId 없으면 시스템(하드필터)
model ApplicationEvent {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  from          ApplicationStatus?
  to            ApplicationStatus
  reason        String?
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  @@index([applicationId, createdAt])
}

// ── M3: 알림 ─────────────────────────────────────────

enum NotificationKind {
  digest // 주간 다이제스트 (월 09:00)
  deadline // 마감 알림 (D-7/D-3/D-1)
  review // 리뷰 요청 (M5)
}

/// Slack으로 보낸 메시지 기록. dedupeKey는 일정 발송이 성공했을 때만 채워 같은 주·같은 날 중복 발송을 막는다
model Notification {
  id        String           @id @default(cuid())
  kind      NotificationKind
  dedupeKey String?          @unique // 예: digest:2026-11-23
  text      String
  itemCount Int
  ok        Boolean
  error     String?
  manual    Boolean          @default(false)
  userId    String?
  alerts    DeadlineAlert[]
  createdAt DateTime         @default(now())

  @@index([kind, createdAt])
}

/// 공고별로 어느 마감 구간(7/3/1) 알림을 보냈는지
model DeadlineAlert {
  id             String       @id @default(cuid())
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  bucket         Int // 7 | 3 | 1
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([applicationId, bucket])
}

// ── M4 초안 ─────────────────────────────

enum DraftStatus {
  preparing // 첨부 받기·양식 읽기·섹션 정하기
  generating // 섹션별 초안 쓰는 중
  ready
  failed
}

/// Application당 여러 버전. 새로 만들면 version+1
model Draft {
  id                 String         @id @default(cuid())
  applicationId      String
  application        Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  version            Int
  status             DraftStatus    @default(preparing)
  /// form(양식에서 섹션 추출) | default:startup | default:voucher | default:rnd
  templateSource     String?
  formAttachmentId   String?
  formAttachment     Attachment?    @relation(fields: [formAttachmentId], references: [id], onDelete: SetNull)
  /// 공고·양식에서 뽑은 평가 기준 (섹션 초안 입력)
  criteria           String[]
  /// 준비 과정 메모 ("양식을 못 읽어 기본 템플릿으로" 등)
  notes              String[]
  error              String?
  model              String?
  promptVersion      String?
  createdById        String?
  createdBy          User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sections           DraftSection[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([applicationId, version])
}

enum SectionStatus {
  empty
  generating
  done
  failed
}

model DraftSection {
  id            String        @id @default(cuid())
  draftId       String
  draft         Draft         @relation(fields: [draftId], references: [id], onDelete: Cascade)
  order         Int
  key           String
  title         String
  guidance      String? // 작성 요령 (양식의 안내문)
  limitChars    Int?
  content       String        @default("")
  /// 마지막으로 AI가 쓴 본문 (사람이 고친 뒤 "AI 초안과 비교"용)
  aiContent     String?
  comments      ReviewComment[]
  /// 【확인 필요】 목록 (모델이 준 것 + 본문에서 찾은 것)
  needsCheck    String[]
  generatedBy   String? // ai | human
  status        SectionStatus @default(empty)
  error         String?
  model         String?
  promptVersion String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([draftId, order])
}

enum RequiredDocStatus {
  ready
  missing
  na
}

/// 제출 서류 체크리스트. 공고에서 뽑거나(announcement) 사람이 추가(manual)
model RequiredDoc {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  note          String?
  required      Boolean           @default(true)
  status        RequiredDocStatus @default(missing)
  source        String            @default("announcement")
  order         Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([applicationId, name])
}

// ── M5 리뷰 ─────────────────────────────

/// 섹션 코멘트. 초안 버전에 묶인다 (새 버전을 만들면 이전 버전에 남음)
model ReviewComment {
  id           String       @id @default(cuid())
  sectionId    String
  section      DraftSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body         String
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?        @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([sectionId, createdAt])
}

// 화면에서 넣은 연결 키 (Anthropic·Slack·기업마당·공공데이터포털). AUTH_SECRET으로 AES-256-GCM 암호화.
// .env에 같은 이름이 있으면 .env가 먼저다 (src/server/secrets.ts)
model AppSecret {
  name        String   @id // 환경 변수 이름 (ANTHROPIC_API_KEY 등)
  ciphertext  String // base64(iv).base64(tag).base64(data)
  last4       String // 화면 표시용 끝 4자리
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
