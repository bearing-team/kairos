# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env example is committed
!.env.example

# local uploads
/storage/

/src/generated/prisma

# prisma generated client
/src/generated/

# 실제 공고 양식 샘플 (공개 공고 첨부, 커밋하지 않음). 목록은 manifest.tsv
fixtures/forms/*
!fixtures/forms/manifest.tsv
!fixtures/forms/README.md
# 첨부·초안 파일 저장소 (STORAGE_DRIVER=local)
storage/
